;
; driver.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = driver.cat
DriverVer   = 01/01/2020,1.0.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
driver.sys = 1,,

;*************DriverVer   ****************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NTamd64.10.0...16299

[Standard.NTamd64.10.0...16299]
%driver.DeviceDesc% = driver_Device, Root\pfnwatch

[driver_Device.NT]
CopyFiles = File_Copy

[File_Copy]
driver.sys

;-------------- Service installation
[driver_Device.NT.Services]
AddService = pfnwatch,%SPSVCINST_ASSOCSERVICE%, driver_Service_Inst

; -------------- driver install sections
[driver_Service_Inst]
DisplayName    = %driver.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\driver.sys

[driver_Device.NT.Wdf]
KmdfService = pfnwatch, driver_wdfsect

[driver_wdfsect]
KmdfLibraryVersion = 1.15

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "pfnwatch"
DiskName = "pfnwatch Installation Disk"
driver.DeviceDesc = "pfnwatch Device"
driver.SVCDESC = "pfnwatch Service"
